{
  "format": "clicks-auto-script",
  "version": 1,
  "id": "sc_170f7439",
  "name": "Example - Wikipedia search",
  "description": "Opens Wikipedia, searches for a term and screenshots the result.",
  "author": "",
  "start_url": "https://en.wikipedia.org/wiki/Main_Page",
  "created_at": "2026-10-11T11:29:21+00:00",
  "updated_at": "2026-10-11T11:29:21+00:00",
  "source": "manual",
  "keep_alive": true,
  "variables": {
    "term": "Automation"
  },
  "defaults": {
    "step_timeout_ms": 20000,
    "navigation_timeout_ms": 45000,
    "retries": 2,
    "retry_delay_ms": 700,
    "delay_between_steps_ms": 250,
    "delay_between_loops_ms": 1200
  },
  "steps": [
    {
      "type": "goto",
      "id": "s_ad4b8b52",
      "description": "Open Wikipedia",
      "value": "https://en.wikipedia.org/wiki/Main_Page"
    },
    {
      "type": "wait_for",
      "id": "s_1fa56b9f",
      "description": "Search box",
      "selector": "input[name='search']",
      "fallbacks": [
        {
          "kind": "css",
          "value": "#searchInput"
        }
      ]
    },
    {
      "type": "fill",
      "id": "s_a1baacd2",
      "description": "Search box",
      "selector": "input[name='search']",
      "value": "${term}",
      "options": {
        "press_enter": true,
        "clear_first": true
      }
    },
    {
      "type": "wait_for",
      "id": "s_4c3a75cb",
      "description": "Result heading",
      "selector": "#firstHeading"
    },
    {
      "type": "assert_text",
      "id": "s_1cf1d3d4",
      "description": "Result heading",
      "selector": "#firstHeading",
      "value": "Automation",
      "options": {
        "match": "contains"
      }
    },
    {
      "type": "screenshot",
      "id": "s_119d08ae",
      "options": {
        "path": "wikipedia.png",
        "full_page": false
      }
    }
  ]
}
